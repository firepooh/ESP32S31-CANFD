# ESP32-S31-Function-CoreBoard-1 (ESP32-S31-WROOM-3, 16 MB flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console on the USB Serial/JTAG port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 16 MB octal PSRAM on ESP32-S31-WROOM-3, added to the heap (malloc > 16 KB goes to PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y

# CAN queues: RX event queue, TX free-slot queue and TX frame pool buffers in PSRAM
CONFIG_CANFD_QUEUE_IN_PSRAM=y
CONFIG_CANFD_RX_QUEUE_DEPTH=1024
CONFIG_CANFD_TX_QUEUE_DEPTH=64

# USB Candlelight adapter on the HS OTG port: two vendor interfaces (CAN1, CAN2),
# no vendor FIFOs (one USB transfer = one protocol message), 2 KB transfers for blobs
CONFIG_CANDLE_USB_ENABLE=y
CONFIG_TINYUSB_VENDOR_COUNT=2
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=0
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=0
CONFIG_TINYUSB_VENDOR_EPSIZE=2048
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_TINYUSB_MSC_ENABLED=n
CONFIG_TINYUSB_NET_MODE_NONE=y
CONFIG_TINYUSB_DFU_MODE_NONE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
